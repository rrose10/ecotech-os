APP_NAME="EcoTech OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain-or-ip
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL is recommended for many users at the same time
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecotech_os
DB_USERNAME=ecotech
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database
